{
  "name": "aam-registry-frontend",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/aam-registry-frontend/src",
  "tags": ["type:app", "scope:web", "lang:typescript"],
  "targets": {
    "build": {
      "executor": "@nx/vite:build",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/aam-registry-frontend"
      }
    },
    "serve": {
      "executor": "@nx/vite:dev-server",
      "options": {
        "buildTarget": "aam-registry-frontend:build",
        "port": 3001
      }
    },
    "preview": {
      "executor": "@nx/vite:preview-server",
      "options": {
        "buildTarget": "aam-registry-frontend:build",
        "port": 4301
      }
    },
    "test": {
      "executor": "@nx/vite:test",
      "options": {
        "reportsDirectory": "../../coverage/apps/aam-registry-frontend"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
